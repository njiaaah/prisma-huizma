{
  "name": "prisma-huisma",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "bun install && bun install --cwd frontend && bun x prisma migrate deploy && bun x prisma generate",
    "install:all": "bun run setup",
    "dev": "node scripts/dev.mjs",
    "dev:api": "bun --hot index.ts",
    "dev:studio": "bun x --bun prisma studio",
    "dev:frontend": "bun --cwd frontend run dev",
    "migrate": "bun x prisma migrate dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/jwt": "^1.4.2",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "elysia": "^1.4.28"
  }
}
