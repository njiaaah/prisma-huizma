generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id    Int    @id @default(autoincrement())
  email String? @unique
  name  String? @default("Anonymous")
  registeredAt DateTime @default(now())
  passwordHash String? 
  registerHash String? @unique
}